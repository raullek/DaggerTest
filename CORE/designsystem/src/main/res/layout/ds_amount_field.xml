<?xml version="1.0" encoding="utf-8"?>
<!-- Крупный ввод суммы ДС: подпись + большое поле + суффикс валюты + ошибка. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="@dimen/ds_space_l"
    android:paddingBottom="@dimen/ds_space_l">

    <TextView
        android:id="@+id/ds_label"
        style="@style/DsSectionSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/ds_input"
            style="@style/DsAmountInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:hint="0"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/ds_suffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_m"
            android:text="₽"
            android:textColor="@color/ds_on_surface"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ds_error"
        style="@style/DsError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone" />
</LinearLayout>
