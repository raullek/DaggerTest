<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «витрина товаров» для чата. Вёрсткой владеет фича catalog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Витрина каталога"
        android:textColor="#FF6B7280"
        android:textSize="12sp" />

    <!-- Строки товаров добавляются программно после загрузки из репозитория фичи. -->
    <LinearLayout
        android:id="@+id/products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <Button
        android:id="@+id/open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="В каталог" />
</LinearLayout>
